rules_version='2'; service cloud.firestore { match /databases/{d}/documents {
 match /sheets/{id} { allow get: if true; allow list, create: if request.auth!=null;
  allow update, delete: if request.auth!=null && (resource.data.owner==request.auth.uid ||
   (resource.data.campaign!=null && get(/databases/$(d)/documents/campaigns/$(resource.data.campaign)).data.master==request.auth.uid)); }
 match /campaigns/{id} { allow read, create: if request.auth!=null;
  allow update: if request.auth!=null && (resource.data.master==request.auth.uid ||
   (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
    request.resource.data.members is list && request.resource.data.members.size()==request.resource.data.members.toSet().size() &&
    (request.resource.data.members==resource.data.members ||
     (request.auth.uid in resource.data.members && !(request.auth.uid in request.resource.data.members) &&
      request.resource.data.members.toSet()==resource.data.members.toSet().difference([request.auth.uid].toSet())) ||
     (!(request.auth.uid in resource.data.members) && request.auth.uid in request.resource.data.members &&
      request.resource.data.members.toSet()==resource.data.members.toSet().union([request.auth.uid].toSet())))));
  allow delete: if request.auth!=null && resource.data.master==request.auth.uid; }
 match /campaigns/{id}/investigation/{itemId} {
  allow read, write: if request.auth!=null &&
   get(/databases/$(d)/documents/campaigns/$(id)).data.master==request.auth.uid; }
 match /campaigns/{id}/playerInvestigation/{itemId} {
  allow read, write: if request.auth!=null &&
   (request.auth.uid in get(/databases/$(d)/documents/campaigns/$(id)).data.members ||
    get(/databases/$(d)/documents/campaigns/$(id)).data.master==request.auth.uid); }
 /* Layout base dos portraits de OBS (um por campanha). O OBS não faz login, então a leitura é pública; só o mestre grava. */
 match /layouts/{id} { allow get: if true;
  allow create, update, delete: if request.auth!=null && get(/databases/$(d)/documents/campaigns/$(id)).data.master==request.auth.uid; }

 /* Perfil público (nome de exibição, @, foto, hash do e-mail para busca). Qualquer usuário logado lê; só o dono grava. */
 match /profiles/{uid} { allow read: if request.auth!=null; allow create, update, delete: if request.auth!=null && request.auth.uid==uid; }
 /* @ de usuário único: usernames/{@} -> { uid }. Não pode ser sobrescrito por outra pessoa (update é negado). */
 match /usernames/{h} { allow read: if request.auth!=null;
  allow create: if request.auth!=null && request.resource.data.uid==request.auth.uid;
  allow delete: if request.auth!=null && resource.data.uid==request.auth.uid; }
 /* Preferências privadas: tema, idioma, fichas/campanha recentes, ordem das fichas. */
 match /users/{uid} { allow read, write: if request.auth!=null && request.auth.uid==uid; }
 /* Solicitações: só os participantes leem; o destinatário aceita ou recusa. */
 match /friendRequests/{id} {
  allow get: if request.auth!=null && (resource==null || resource.data.to==request.auth.uid || resource.data.from==request.auth.uid);
  allow list: if request.auth!=null && (resource.data.to==request.auth.uid || resource.data.from==request.auth.uid);
  allow create: if request.auth!=null && request.resource.data.from==request.auth.uid &&
   request.resource.data.to is string && request.resource.data.to!=request.auth.uid &&
   id==request.auth.uid+'_'+request.resource.data.to &&
   request.resource.data.keys().hasOnly(['from','to','created']) &&
   request.resource.data.keys().hasAll(['from','to','created']) &&
   exists(/databases/$(d)/documents/profiles/$(request.resource.data.to));
  allow delete: if request.auth!=null && (resource.data.to==request.auth.uid || resource.data.from==request.auth.uid);
 }
 /* Amizades só são criadas ao aceitar uma solicitação recebida. */
 match /friendships/{id} { allow get: if request.auth!=null;
  allow list: if request.auth!=null && request.auth.uid in resource.data.members;
  allow create: if request.auth!=null && request.resource.data.members.size()==2 &&
   request.resource.data.members[0]==request.auth.uid && request.resource.data.members[1] is string &&
   request.resource.data.members[1]!=request.auth.uid && request.resource.data.from==request.auth.uid &&
   request.resource.data.keys().hasOnly(['members','from','created']) &&
   request.resource.data.keys().hasAll(['members','from','created']) &&
   (id==request.resource.data.members[0]+'_'+request.resource.data.members[1] || id==request.resource.data.members[1]+'_'+request.resource.data.members[0]) &&
   exists(/databases/$(d)/documents/friendRequests/$(request.resource.data.members[1]+'_'+request.auth.uid)) &&
   get(/databases/$(d)/documents/friendRequests/$(request.resource.data.members[1]+'_'+request.auth.uid)).data.from==request.resource.data.members[1] &&
   get(/databases/$(d)/documents/friendRequests/$(request.resource.data.members[1]+'_'+request.auth.uid)).data.to==request.auth.uid;
  allow delete: if request.auth!=null && request.auth.uid in resource.data.members; }
 /* Convites para campanhas: só o mestre cria; quem recebeu aceita/recusa (apaga).
    get em documento inexistente é necessário para verificar se já há convite. */
 match /invites/{id} {
  allow get: if request.auth!=null && (resource==null || resource.data.to==request.auth.uid || resource.data.from==request.auth.uid);
  allow list: if request.auth!=null && (resource.data.to==request.auth.uid || resource.data.from==request.auth.uid);
  allow create: if request.auth!=null && request.resource.data.from==request.auth.uid && get(/databases/$(d)/documents/campaigns/$(request.resource.data.campaign)).data.master==request.auth.uid;
  allow delete: if request.auth!=null && (resource.data.to==request.auth.uid || resource.data.from==request.auth.uid); } } }
